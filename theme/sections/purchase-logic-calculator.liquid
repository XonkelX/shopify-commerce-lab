{% liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign selected_media = selected_variant.featured_media | default: product.featured_media
%}

<section
  id="PurchaseLogic-{{ section.id }}"
  class="purchase-logic"
  style="--pl-accent:{{ section.settings.accent_color }};--pl-bg:{{ section.settings.background_color }};--pl-card:{{ section.settings.card_color }};--pl-text:{{ section.settings.text_color }};--pl-muted:{{ section.settings.muted_color }};"
  data-units-per-case="{{ section.settings.units_per_case }}"
  data-max-units="{{ section.settings.max_units }}"
  data-currency="{{ cart.currency.iso_code | default: shop.currency }}"
>
  <header class="purchase-logic__intro">
    <p>{{ section.settings.eyebrow | escape }}</p>
    <h1>{{ product.title | escape }}</h1>
    <div>{{ section.settings.intro }}</div>
  </header>

  <div class="purchase-logic__layout">
    <div class="pl-product">
      <div class="pl-product__media">
        {% if product.media.size > 0 %}
          {% for media in product.media %}
            <figure data-pl-media="{{ media.id }}"{% unless media.id == selected_media.id %} hidden{% endunless %}>
              {{ media.preview_image | image_url: width: 1200 | image_tag: widths: '480, 720, 960, 1200', sizes: '(min-width: 900px) 42vw, 100vw', loading: 'eager', alt: media.alt | default: product.title }}
            </figure>
          {% endfor %}
        {% else %}
          {{ 'product-1' | placeholder_svg_tag: 'pl-product__placeholder' }}
        {% endif %}
      </div>
      <div class="pl-product__facts">
        <span data-pl-variant>{{ selected_variant.title | escape }}</span>
        <strong data-pl-price>{{ selected_variant.price | money }} per case</strong>
        <span data-pl-availability>{% if selected_variant.available %}Available{% else %}Sold out{% endif %}</span>
      </div>
      <p>{{ section.settings.case_note | escape }}</p>
    </div>

    <form class="pl-form" action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" novalidate>
      <input type="hidden" name="id" value="{{ selected_variant.id }}" data-pl-variant-id>
      <input type="hidden" name="return_to" value="{{ routes.cart_url }}">
      <input type="hidden" name="quantity" value="1" data-pl-quantity>
      <input type="hidden" name="properties[Requested bottles]" value="{{ section.settings.default_units }}" data-pl-property-units>
      <input type="hidden" name="properties[Reserve percent]" value="{{ section.settings.default_reserve }}%" data-pl-property-reserve>
      <input type="hidden" name="properties[Bottles per case]" value="{{ section.settings.units_per_case }}" data-pl-property-coverage>
      <input type="hidden" name="properties[Purchase calculation]" value="" data-pl-property-rule>

      <div class="pl-step">
        <div class="pl-step__heading"><span>1</span><div><p>Choose the case</p><h2>Bottle specification</h2></div></div>
        {% unless product.has_only_default_variant %}
          {% for option in product.options_with_values %}
            <fieldset class="pl-option" data-pl-option="{{ forloop.index0 }}">
              <legend>{{ option.name | escape }}: <span data-pl-option-value>{{ option.selected_value | escape }}</span></legend>
              <div>
                {% for value in option.values %}
                  {% assign option_id = section.id | append: '-pl-' | append: option.position | append: '-' | append: forloop.index %}
                  <input class="visually-hidden" type="radio" id="{{ option_id }}" name="pl-options[{{ option.name | escape }}]" value="{{ value | escape }}" {% if option.selected_value == value %}checked{% endif %}>
                  <label for="{{ option_id }}">{{ value | escape }}</label>
                {% endfor %}
              </div>
            </fieldset>
          {% endfor %}
        {% endunless %}
      </div>

      <div class="pl-step">
        <div class="pl-step__heading"><span>2</span><div><p>Plan the order</p><h2>Case calculator</h2></div></div>
        <div class="pl-inputs">
          <label>
            <span>{{ section.settings.units_label | escape }}</span>
            <input type="number" min="1" max="{{ section.settings.max_units }}" step="1" value="{{ section.settings.default_units }}" inputmode="numeric" data-pl-units>
            <small>Whole bottles, 1–{{ section.settings.max_units }}</small>
          </label>
          <label>
            <span>Reserve allowance</span>
            <span class="pl-suffix"><input type="number" min="0" max="50" step="0.5" value="{{ section.settings.default_reserve }}" inputmode="decimal" data-pl-reserve><b>%</b></span>
            <small>Adds extras for loss or late guests</small>
          </label>
        </div>
        <p class="pl-rule">Each purchasable case contains <strong>{{ section.settings.units_per_case }} bottles</strong>. Partial cases always round up.</p>
        <div class="pl-message" role="alert" aria-live="polite" data-pl-message></div>
      </div>

      <div class="pl-result" aria-live="polite">
        <div class="pl-result__hero"><p>Purchase quantity</p><strong><span data-pl-cases>1</span> <span data-pl-case-word>case</span></strong></div>
        <dl>
          <div><dt>Requested</dt><dd><span data-pl-requested>0</span> <span data-pl-requested-word>bottles</span></dd></div>
          <div><dt>Reserve</dt><dd><span data-pl-buffer>0</span> <span data-pl-buffer-word>bottles</span></dd></div>
          <div><dt>Planned need</dt><dd><span data-pl-total>0</span> <span data-pl-total-word>bottles</span></dd></div>
          <div><dt>Raw case requirement</dt><dd data-pl-raw>0</dd></div>
          <div><dt>Purchased capacity</dt><dd><span data-pl-capacity>0</span> <span data-pl-capacity-word>bottles</span></dd></div>
          <div><dt>Capacity remaining</dt><dd><span data-pl-surplus>0</span> <span data-pl-surplus-word>bottles</span></dd></div>
        </dl>
        <p class="pl-equation" data-pl-equation></p>
        <p class="pl-estimate">Estimated merchandise total: <strong data-pl-estimate>—</strong></p>
        <button type="submit" data-pl-submit><span data-pl-submit-label>Add calculated cases</span></button>
        <p class="pl-price-note">Final cart total uses the selected Shopify variant price × whole-case quantity.</p>
      </div>
    </form>
  </div>

  <script type="application/json" data-pl-variants>
    [{% for variant in product.variants %}{"id":{{ variant.id | json }},"available":{{ variant.available | json }},"price":{{ variant.price | json }},"priceFormatted":{{ variant.price | money | json }},"options":{{ variant.options | json }},"featuredMediaId":{{ variant.featured_media.id | default: 0 | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
  </script>
</section>

{% stylesheet %}
