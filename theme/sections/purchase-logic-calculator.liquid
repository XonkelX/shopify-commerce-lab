h:0;margin:0 0 19px;padding:0;border:0}.pl-option legend{margin-bottom:10px;font-size:.86rem;font-weight:720}.pl-option legend span{color:var(--pl-muted);font-weight:520}.pl-option>div{display:flex;flex-wrap:wrap;gap:9px}.pl-option label{display:inline-flex;min-height:43px;align-items:center;justify-content:center;padding:8px 14px;border:1px solid rgba(31,39,33,.18);border-radius:999px;cursor:pointer;font-size:.86rem;font-weight:680}.pl-option input:checked+label{border-color:var(--pl-text);background:var(--pl-text);color:var(--pl-card);box-shadow:0 0 0 2px var(--pl-card),0 0 0 4px var(--pl-text)}.pl-option input:disabled+label{cursor:not-allowed;opacity:.34;text-decoration:line-through}.pl-inputs{display:grid;grid-template-columns:1fr 1fr;gap:14px}.pl-inputs label{display:grid;gap:7px}.pl-inputs label>span:first-child{font-size:.84rem;font-weight:720}.pl-inputs input{width:100%;min-height:50px;padding:0 13px;border:1px solid rgba(31,39,33,.18);border-radius:12px;background:#fff;color:var(--pl-text);font:inherit}.pl-inputs small{color:var(--pl-muted);font-size:.72rem;line-height:1.4}.pl-suffix{position:relative}.pl-suffix input{padding-right:36px}.pl-suffix b{position:absolute;top:50%;right:13px;transform:translateY(-50%);color:var(--pl-muted)}.pl-rule{margin:20px 0 0;padding:13px 14px;border-radius:12px;background:var(--pl-bg);color:var(--pl-muted);font-size:.82rem;line-height:1.5}.pl-message{min-height:22px;margin-top:10px;color:#9b3a2e;font-size:.84rem;font-weight:680}.pl-result{background:var(--pl-text);color:#fff}.pl-result__hero{display:flex;align-items:flex-end;justify-content:space-between;gap:20px;padding-bottom:18px;border-bottom:1px solid rgba(255,255,255,.16)}.pl-result__hero p{margin:0;color:rgba(255,255,255,.65);font-size:.72rem;font-weight:720;letter-spacing:.1em;text-transform:uppercase}.pl-result__hero strong{font-size:clamp(2rem,5vw,3.5rem);line-height:.9}.pl-result dl{display:grid;grid-template-columns:1fr 1fr;gap:0 22px;margin:18px 0}.pl-result dl div{display:flex;justify-content:space-between;gap:14px;padding:10px 0;border-bottom:1px solid rgba(255,255,255,.1);font-size:.8rem}.pl-result dt{color:rgba(255,255,255,.64)}.pl-result dd{margin:0;text-align:right;font-weight:700}.pl-equation{padding:13px 14px;border-radius:10px;background:rgba(255,255,255,.08);font-family:ui-monospace,SFMono-Regular,Consolas,monospace;font-size:.78rem;line-height:1.5}.pl-estimate{display:flex;justify-content:space-between;gap:16px;margin:18px 0}.pl-result button{width:100%;min-height:56px;border:0;border-radius:12px;background:var(--pl-accent);color:#fff;cursor:pointer;font:inherit;font-weight:760}.pl-result button:disabled{cursor:not-allowed;opacity:.44}.pl-price-note{margin:11px 0 0;color:rgba(255,255,255,.58);font-size:.72rem;text-align:center}.pl-inputs input:focus-visible,.pl-option input:focus-visible+label,.pl-result button:focus-visible{outline:3px solid var(--pl-accent);outline-offset:3px}.visually-hidden{position:absolute!important;width:1px!important;height:1px!important;padding:0!important;margin:-1px!important;overflow:hidden!important;clip:rect(0,0,0,0)!important;white-space:nowrap!important;border:0!important}
  @media(max-width:899px){.purchase-logic__layout{grid-template-columns:1fr}.pl-product{position:static}.pl-product__media{max-height:580px}}
  @media(max-width:520px){.purchase-logic__intro h1{font-size:clamp(2.15rem,11.5vw,3rem)}.pl-step,.pl-result{padding:19px}.pl-inputs,.pl-result dl{grid-template-columns:1fr}.pl-result__hero{align-items:flex-start;flex-direction:column}.pl-result__hero strong{font-size:2.65rem}}
  @media(prefers-reduced-motion:reduce){.purchase-logic *{scroll-behavior:auto!important;transition:none!important}}
{% endstylesheet %}

<script>
  (() => {
    document.querySelectorAll('[id^="PurchaseLogic-"]').forEach((root) => {
      if (root.dataset.initialized === 'true') return;
      root.dataset.initialized = 'true';
      const form = root.querySelector('.pl-form');
      const variants = JSON.parse(root.querySelector('[data-pl-variants]').textContent);
      const groups = [...root.querySelectorAll('[data-pl-option]')];
      const unitsInput = root.querySelector('[data-pl-units]');
      const reserveInput = root.querySelector('[data-pl-reserve]');
      const quantityInput = root.querySelector('[data-pl-quantity]');
      const variantInput = root.querySelector('[data-pl-variant-id]');
      const submit = root.querySelector('[data-pl-submit]');
      const submitLabel = root.querySelector('[data-pl-submit-label]');
      const message = root.querySelector('[data-pl-message]');
      const perCase = Number(root.dataset.unitsPerCase);
      const maxUnits = Number(root.dataset.maxUnits);
      let activeVariant;
      let calculation;
      const chosenOptions = () => groups.map((group) => group.querySelector('input:checked')?.value || '');
      const findVariant = (values) => variants.find((variant) => variant.options.every((value, index) => value === values[index]));
      const clean = (value) => Number.isInteger(value) ? String(value) : value.toFixed(2).replace(/0+$/,'').replace(/\.$/,'');
      const money = (cents) => new Intl.NumberFormat(undefined,{style:'currency',currency:root.dataset.currency}).format(cents / 100);
      const showMedia = (id) => root.querySelectorAll('[data-pl-media]').forEach((media) => { media.hidden = Number(media.dataset.plMedia) !== Number(id); });
      const renderVariant = () => {
        const chosen = chosenOptions(); activeVariant = findVariant(chosen);
        groups.forEach((group,index) => {
          const selected = group.querySelector('input:checked'); if (selected) group.querySelector('[data-pl-option-value]').textContent = selected.value;
          group.querySelectorAll('input[type="radio"]').forEach((radio) => { const candidate=[...chosen]; candidate[index]=radio.value; radio.disabled=!findVariant(candidate); });
        });
        if (!activeVariant) { submit.disabled=true; submitLabel.textContent='Unavailable'; return; }
        variantInput.value=activeVariant.id; root.querySelector('[data-pl-variant]').textContent=activeVariant.options.join(' / '); root.querySelector('[data-pl-price]').textContent=`${activeVariant.priceFormatted} per case`; root.querySelector('[data-pl-availability]').textContent=activeVariant.available?'Available':'Sold out'; if(activeVariant.featuredMediaId) showMedia(activeVariant.featuredMediaId);
        const url=new URL(window.location.href); url.searchParams.set('variant',activeVariant.id); window.history.replaceState({},'',url); calculate();
      };
      const calculate = () => {
        const requested=Number(unitsInput.value); const reserve=Number(reserveInput.value);
        let error='';
        if(!Number.isInteger(requested)||requested<1) error='Enter a whole requested quantity of at least 1.';
        else if(requested>maxUnits) error=`Requested quantity cannot exceed ${maxUnits}.`;
        else if(!Number.isFinite(reserve)||reserve<0||reserve>50) error='Reserve allowance must be between 0% and 50%.';
        message.textContent=error;
        if(error){ calculation=null; submit.disabled=true; submitLabel.textContent='Fix calculator values'; return; }
        const buffer=requested*(reserve/100); const total=requested+buffer; const raw=total/perCase; const cases=Math.ceil(raw); const capacity=cases*perCase; const surplus=capacity-total;
        calculation={requested,reserve,buffer,total,raw,cases,capacity,surplus};
        const caseWord=cases===1?'case':'cases'; root.querySelector('[data-pl-cases]').textContent=cases; root.querySelector('[data-pl-case-word]').textContent=caseWord; root.querySelector('[data-pl-requested]').textContent=clean(requested); root.querySelector('[data-pl-buffer]').textContent=clean(buffer); root.querySelector('[data-pl-total]').textContent=clean(total); root.querySelector('[data-pl-raw]').textContent=raw.toFixed(2); root.querySelector('[data-pl-capacity]').textContent=clean(capacity); root.querySelector('[data-pl-surplus]').textContent=clean(surplus); [['requested',requested],['buffer',buffer],['total',total],['capacity',capacity],['surplus',surplus]].forEach(([key,value])=>{root.querySelector(`[data-pl-${key}-word]`).textContent=value===1?'bottle':'bottles'}); root.querySelector('[data-pl-equation]').textContent=`ceil((${clean(requested)} × ${clean(1+reserve/100)}) ÷ ${perCase}) = ${cases} ${caseWord}`; root.querySelector('[data-pl-estimate]').textContent=activeVariant?money(activeVariant.price*cases):'—';
        quantityInput.value=cases; root.querySelector('[data-pl-property-units]').value=clean(requested); root.querySelector('[data-pl-property-reserve]').value=`${clean(reserve)}%`; root.querySelector('[data-pl-property-rule]').value=`ceil((${clean(requested)} × ${clean(1+reserve/100)}) ÷ ${perCase}) = ${cases} cases`; submit.disabled=!activeVariant?.available; submitLabel.textContent=activeVariant?.available?`Add ${cases} ${cases===1?'case':'cases'}`:'Sold out';
      };
      groups.forEach((group)=>group.querySelectorAll('input').forEach((input)=>input.addEventListener('change',renderVariant)));
      unitsInput.addEventListener('input',calculate); reserveInput.addEventListener('input',calculate);
      form.addEventListener('submit',(event)=>{ event.preventDefault(); calculate(); if(!calculation||!activeVariant?.available)return; submit.disabled=true; submitLabel.textContent='Adding…'; if(window.ShopifyCartDrawer){window.ShopifyCartDrawer.add(form,submit).then(()=>{submitLabel.textContent='Added';}).catch((error)=>{message.textContent=error.message||'This item could not be added.';submit.disabled=false;submitLabel.textContent=`Add ${calculation.cases} ${calculation.cases===1?'case':'cases'}`;});return;} HTMLFormElement.prototype.submit.call(form); });
      renderVariant();
    });
  })();
</script>

{% schema %}
{
  "name": "Case quantity calculator",
  "tag": "section",
  "class": "purchase-logic-section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Plan by case, not guesswork" },
    { "type": "richtext", "id": "intro", "label": "Introduction", "default": "<p>Enter the event requirement and reserve allowance. The calculator rounds up to the whole cases Shopify can actually sell.</p>" },
    { "type": "text", "id": "units_label", "label": "Required units label", "default": "Bottles required" },
    { "type": "text", "id": "case_note", "label": "Product note", "default": "Case quantities are calculated before the Shopify product form is submitted." },
    { "type": "range", "id": "units_per_case", "label": "Bottles per case", "min": 2, "max": 48, "step": 1, "default": 12 },
    { "type": "range", "id": "default_units", "label": "Default bottles required", "min": 25, "max": 225, "step": 2, "default": 125 },
    { "type": "range", "id": "default_reserve", "label": "Default reserve percent", "min": 0, "max": 25, "step": 1, "default": 10 },
    { "type": "range", "id": "max_units", "label": "Maximum bottles per order", "min": 300, "max": 3000, "step": 100, "default": 2000 },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#f3f0e8" },
    { "type": "color", "id": "card_color", "label": "Card", "default": "#fffdf8" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1f2721" },
    { "type": "color", "id": "muted_color", "label": "Muted text", "default": "#687168" },
    { "type": "color", "id": "accent_color", "label": "Accent", "default": "#b95538" }
  ],
  "presets": [{ "name": "Case quantity calculator" }]
}
{% endschema %}
