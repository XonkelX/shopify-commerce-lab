{% liquid
  assign heading_id = 'ComparisonHeading-' | append: section.id
%}

<section
  id="Comparison-{{ section.id }}"
  class="comparison-section{% if section.settings.full_width %} comparison-section--full{% endif %}"
  aria-labelledby="{{ heading_id }}"
  style="
    --comparison-background: {{ section.settings.background_color }};
    --comparison-card: {{ section.settings.card_color }};
    --comparison-text: {{ section.settings.text_color }};
    --comparison-muted: {{ section.settings.muted_color }};
    --comparison-accent: {{ section.settings.accent_color }};
    --comparison-radius: {{ section.settings.corner_radius }}px;
    --comparison-columns: {{ section.settings.columns }};
    --comparison-padding-top: {{ section.settings.padding_top }}px;
    --comparison-padding-bottom: {{ section.settings.padding_bottom }}px;
  "
>
  <div class="comparison-section__inner">
    <div class="comparison-section__header comparison-section__header--{{ section.settings.alignment }}">
      {% if section.settings.eyebrow != blank %}
        <p class="comparison-section__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 id="{{ heading_id }}" class="comparison-section__heading">{{ section.settings.heading | escape }}</h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="comparison-section__description rte">{{ section.settings.description }}</div>
      {% endif %}
    </div>

    {% if section.blocks.size > 0 %}
      <div class="comparison-grid">
        {% for block in section.blocks %}
          {% liquid
            assign selected_product = block.settings.product
            assign card_title = block.settings.title
            if card_title == blank and selected_product != blank
              assign card_title = selected_product.title
            endif

            assign card_link = block.settings.link
            if card_link == blank and selected_product != blank
              assign card_link = selected_product.url
            endif

            assign card_image = block.settings.image
            if card_image == blank and selected_product != blank
              assign card_image = selected_product.featured_image
            endif
          %}

          <article class="comparison-card" {{ block.shopify_attributes }}>
            <div class="comparison-card__media comparison-card__media--{{ section.settings.image_ratio }}">
              {% if block.settings.badge != blank %}
                <span class="comparison-card__badge">{{ block.settings.badge | escape }}</span>
              {% endif %}

              {% if card_image != blank %}
                {{
                  card_image
                  | image_url: width: 900
                  | image_tag:
                    widths: '320, 480, 640, 900',
                    sizes: '(min-width: 990px) 30vw, (min-width: 640px) 44vw, 82vw',
                    loading: 'lazy',
                    class: 'comparison-card__image'
                }}
              {% elsif block.settings.demo_image != 'none' %}
                <img
                  src="{{ 'comparison-' | append: block.settings.demo_image | append: '.jpg' | asset_url }}"
                  alt="{{ card_title | escape }}"
                  width="800"
                  height="800"
                  loading="lazy"
                  class="comparison-card__image"
                >
              {% else %}
                {{ 'product-1' | placeholder_svg_tag: 'comparison-card__placeholder' }}
              {% endif %}
            </div>

            <div class="comparison-card__body">
              {% if card_title != blank %}
                <h3 class="comparison-card__title">{{ card_title | escape }}</h3>
              {% endif %}

              {% if section.settings.show_price %}
                {% if block.settings.price_text != blank %}
                  <p class="comparison-card__price">{{ block.settings.price_text | escape }}</p>
                {% elsif selected_product != blank %}
                  <p class="comparison-card__price">{{ selected_product.price | money }}</p>
                {% endif %}
              {% endif %}

              <dl class="comparison-card__features">
                {% for feature_index in (1..3) %}
                  {% liquid
                    assign label_key = 'feature_' | append: feature_index | append: '_label'
                    assign value_key = 'feature_' | append: feature_index
                    assign feature_label = section.settings[label_key]
                    assign feature_value = block.settings[value_key]
                  %}
                  {% if feature_label != blank and feature_value != blank %}
                    <div class="comparison-card__feature">
                      <dt>{{ feature_label | escape }}</dt>
                      <dd>{{ feature_value | escape }}</dd>
                    </div>
                  {% endif %}
                {% endfor %}
              </dl>

              {% if block.settings.button_label != blank and card_link != blank %}
                <a class="comparison-card__button" href="{{ card_link }}">
                  {{ block.settings.button_label | escape }}
                  <span aria-hidden="true">→</span>
                </a>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="comparison-section__empty">
        <p>Add comparison items in the Theme Editor to build this section.</p>
      </div>
    {% endif %}
  </div>
</section>

{% stylesheet %}
  .comparison-section {
    width: 100%;
    padding-block: var(--comparison-padding-top) var(--comparison-padding-bottom);
    background: var(--comparison-background);
    color: var(--comparison-text);
  }

  .comparison-section--full {
    grid-column: 1 / -1;
  }

  .comparison-section__inner {
    width: min(100% - 2rem, 76rem);
    margin-inline: auto;
  }

  .comparison-section__header {
    max-width: 46rem;
    margin-bottom: clamp(2rem, 5vw, 3.5rem);
  }

  .comparison-section__header--center {
    margin-inline: auto;
    text-align: center;
  }

  .comparison-section__eyebrow {
    margin-bottom: 0.75rem;
    color: var(--comparison-accent);
    font-size: 0.75rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .comparison-section__heading {
    max-width: 18ch;
    margin-inline: inherit;
    font-size: clamp(2rem, 5vw, 3.75rem);
    line-height: 0.98;
    letter-spacing: -0.045em;
  }

  .comparison-section__description {
    margin-top: 1.25rem;
    color: var(--comparison-muted);
    font-size: clamp(1rem, 2vw, 1.125rem);
    line-height: 1.65;
  }

  .comparison-grid {
    display: grid;
    grid-template-columns: repeat(var(--comparison-columns), minmax(0, 1fr));
    gap: 1rem;
    align-items: stretch;
  }

  .comparison-card {
    display: flex;
    min-width: 0;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--comparison-text) 12%, transparent);
    border-radius: var(--comparison-radius);
    background: var(--comparison-card);
    box-shadow: 0 1.25rem 3rem color-mix(in srgb, var(--comparison-text) 8%, transparent);
  }

  .comparison-card__media {
    position: relative;
    overflow: hidden;
    background: color-mix(in srgb, var(--comparison-card) 88%, var(--comparison-accent));
  }

  .comparison-card__media--square {
    aspect-ratio: 1;
  }

  .comparison-card__media--portrait {
    aspect-ratio: 4 / 5;
  }

  .comparison-card__image,
  .comparison-card__placeholder {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .comparison-card__placeholder {
    padding: 20%;
    fill: color-mix(in srgb, var(--comparison-muted) 25%, transparent);
  }

  .comparison-card__badge {
    position: absolute;
    z-index: 1;
    top: 1rem;
    left: 1rem;
    padding: 0.42rem 0.7rem;
    border-radius: 999px;
    background: var(--comparison-accent);
    color: var(--comparison-card);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .comparison-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    padding: clamp(1.25rem, 3vw, 1.75rem);
  }

  .comparison-card__title {
    font-size: clamp(1.3rem, 2vw, 1.65rem);
    line-height: 1.15;
    letter-spacing: -0.025em;
  }

  .comparison-card__price {
    margin-top: 0.6rem;
    color: var(--comparison-accent);
    font-weight: 700;
  }

  .comparison-card__features {
    margin-block: 1.5rem;
    border-top: 1px solid color-mix(in srgb, var(--comparison-text) 12%, transparent);
  }

  .comparison-card__feature {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    padding-block: 0.85rem;
    border-bottom: 1px solid color-mix(in srgb, var(--comparison-text) 12%, transparent);
  }

  .comparison-card__feature dt {
    color: var(--comparison-muted);
  }

  .comparison-card__feature dd {
    margin: 0;
    font-weight: 650;
    text-align: right;
  }

  .comparison-card__button {
    display: inline-flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3rem;
    margin-top: auto;
    padding: 0.75rem 1rem;
    border: 1px solid var(--comparison-accent);
    border-radius: calc(var(--comparison-radius) * 0.55);
    color: var(--comparison-accent);
    font-weight: 700;
    text-decoration: none;
    transition: background-color 160ms ease, color 160ms ease, transform 160ms ease;
  }

  .comparison-card__button:hover {
    background: var(--comparison-accent);
    color: var(--comparison-card);
    transform: translateY(-1px);
  }

  .comparison-card__button:focus-visible {
    outline: 3px solid color-mix(in srgb, var(--comparison-accent) 45%, transparent);
    outline-offset: 3px;
  }

  .comparison-section__empty {
    padding: 2rem;
    border: 1px dashed var(--comparison-muted);
    border-radius: var(--comparison-radius);
    text-align: center;
  }

  @media (max-width: 989px) {
    .comparison-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 639px) {
    .comparison-section__inner {
      width: min(100% - 1.25rem, 76rem);
    }

    .comparison-grid {
      display: flex;
      gap: 0.75rem;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: thin;
      padding: 0.25rem 0.25rem 1rem;
      margin-inline: -0.25rem;
    }

    .comparison-card {
      flex: 0 0 min(82vw, 21rem);
      scroll-snap-align: center;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .comparison-card__button {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product comparison",
  "tag": "section",
  "class": "product-comparison-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Find your fit"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Compare the collection"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Three sizes, one dependable design. Choose the capacity that fits your day.</p>"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Text alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" }
      ],
      "default": "center"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Desktop columns",
      "options": [
        { "value": "2", "label": "2" },
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "3"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image ratio",
      "options": [
        { "value": "square", "label": "Square" },
        { "value": "portrait", "label": "Portrait" }
      ],
      "default": "square"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "label": "Show price",
      "default": true
    },
    {
      "type": "text",
      "id": "feature_1_label",
      "label": "Feature 1 label",
      "default": "Capacity"
    },
    {
      "type": "text",
      "id": "feature_2_label",
      "label": "Feature 2 label",
      "default": "Cold retention"
    },
    {
      "type": "text",
      "id": "feature_3_label",
      "label": "Feature 3 label",
      "default": "Best for"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background",
      "default": "#F3F0E9"
    },
    {
      "type": "color",
      "id": "card_color",
      "label": "Card",
      "default": "#FFFEFB"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text",
      "default": "#17231D"
    },
    {
      "type": "color",
      "id": "muted_color",
      "label": "Muted text",
      "default": "#607067"
    },
    {
      "type": "color",
      "id": "accent_color",
      "label": "Accent",
      "default": "#2E6A4F"
    },
    {
      "type": "range",
      "id": "corner_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "checkbox",
      "id": "full_width",
      "label": "Full-width background",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding",
      "min": 24,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding",
      "min": 24,
      "max": 120,
      "step": 8,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Comparison item",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image override"
        },
        {
          "type": "select",
          "id": "demo_image",
          "label": "Demo image",
          "info": "Used only when no product or image override is selected.",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "compact", "label": "Compact bottle" },
            { "value": "everyday", "label": "Everyday bottle" },
            { "value": "summit", "label": "Summit bottle" }
          ],
          "default": "none"
        },
        {
          "type": "text",
          "id": "badge",
          "label": "Badge"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title override"
        },
        {
          "type": "text",
          "id": "price_text",
          "label": "Price override"
        },
        {
          "type": "text",
          "id": "feature_1",
          "label": "Feature 1 value"
        },
        {
          "type": "text",
          "id": "feature_2",
          "label": "Feature 2 value"
        },
        {
          "type": "text",
          "id": "feature_3",
          "label": "Feature 3 value"
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "View details"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link override"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product comparison",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
