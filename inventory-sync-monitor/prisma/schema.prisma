// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id            String    @id
  shop          String
  state         String
  isOnline      Boolean   @default(false)
  scope         String?
  expires       DateTime?
  accessToken   String
  userId        BigInt?
  firstName     String?
  lastName      String?
  email         String?
  accountOwner  Boolean   @default(false)
  locale        String?
  collaborator  Boolean?  @default(false)
  emailVerified Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

enum SyncStatus {
  PENDING
  SUCCEEDED
  FAILED
  SKIPPED
}

enum SyncTrigger {
  MANUAL
  WEBHOOK
}

enum EventStatus {
  PROCESSING
  PROCESSED
  FAILED
}

model InventoryMapping {
  id                      String   @id @default(cuid())
  shop                    String
  sku                     String
  productTitle            String?
  variantTitle            String?
  inventoryItemId         String
  locationId              String
  locationName            String?
  lastShopifyQuantity     Int?
  lastExternalQuantity    Int?
  lastStatus              SyncStatus @default(PENDING)
  lastError               String?
  lastSyncedAt            DateTime?
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@unique([shop, inventoryItemId, locationId])
  @@index([shop, sku])
}

model SyncRun {
  id                  String      @id @default(cuid())
  shop                String
  trigger             SyncTrigger
  status              SyncStatus  @default(PENDING)
  idempotencyKey      String
  webhookEventId      String?
  sku                 String
  productTitle        String?
  variantTitle        String?
  inventoryItemId     String
  locationId          String
  locationName        String?
  previousQuantity    Int
  targetQuantity      Int?
  finalQuantity       Int?
  attemptCount        Int         @default(0)
  error               String?
  startedAt           DateTime    @default(now())
  finishedAt          DateTime?
  createdAt           DateTime    @default(now())
  attempts            SyncAttempt[]

  @@unique([shop, idempotencyKey])
  @@index([shop, createdAt])
  @@index([webhookEventId])
}

model SyncAttempt {
  id          String   @id @default(cuid())
  syncRunId   String
  attempt     Int
  stage       String
  statusCode  Int?
  message     String
  durationMs  Int
  createdAt   DateTime @default(now())
  syncRun     SyncRun  @relation(fields: [syncRunId], references: [id], onDelete: Cascade)

  @@unique([syncRunId, stage, attempt])
}

model WebhookEvent {
  id          String      @id
  shop        String
  topic       String
  status      EventStatus @default(PROCESSING)
  payload     Json
  error       String?
  receivedAt  DateTime    @default(now())
  processedAt DateTime?

  @@index([shop, receivedAt])
}
